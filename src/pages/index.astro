---
import Layout from '../layouts/Layout.astro';
import List from '../components/List.astro';
import { getBlogPosts, getWeeklyPosts, getUrl, parseWeeklyTitle, formatDate } from '../utils/content';

const weeklyPosts = await getWeeklyPosts();
const blogPosts = await getBlogPosts();

const weeklyList = weeklyPosts.slice(0, 5).map((post) => ({
  title: parseWeeklyTitle(post).title,
  date: formatDate(post.data.date),
  url: getUrl(post),
}));

const blogList = blogPosts.slice(0, 5).map((post) => ({
  title: post.data.title,
  date: formatDate(post.data.date),
  url: getUrl(post),
}));

const moreClass = 'mt-4 inline-block text-sm leading-5 text-[#8a8a8a] link-underline hover:text-ink';
---

<Layout home>
  <section>
    <h2 class="text-[24px] sm:text-[28px] leading-normal font-bold text-ink">Hello, I'm Paranoid_K</h2>
    <p class="mt-4.5 text-sm leading-[1.85] text-[#555]">
      🧑‍💻 前端开发者 / Front-end Developer
    </p>
    <p class="mt-0.5 text-sm leading-[1.85] text-[#555]">
      🤩 正在做一些有趣的事 / Working on something interesting
    </p>
  </section>

  <section class="mt-18">
    <h2 class="text-lg leading-6 font-semibold text-ink">周刊</h2>
    <List class="mt-6" data={weeklyList} />
    <a class={moreClass} href="/weekly">全部周刊</a>
  </section>

  <section class="mt-18 pb-10">
    <h2 class="text-lg leading-6 font-semibold text-ink">博客</h2>
    <List class="mt-5" data={blogList} />
    <a class={moreClass} href="/blog">全部文章</a>
  </section>
</Layout>
