---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Article from '../../components/Article.astro';
import { type Post, getWeeklyPosts, getSlug, getUrl, parseWeeklyTitle, formatLongDate } from '../../utils/content';

export async function getStaticPaths() {
  const posts = await getWeeklyPosts();
  // posts 按日期倒序：后一项更早，前一项更新
  return posts.map((post, index) => ({
    params: { slug: getSlug(post) },
    props: { post, older: posts[index + 1], newer: posts[index - 1] },
  }));
}

interface Props {
  post: Post;
  older?: Post;
  newer?: Post;
}

const { post, older, newer } = Astro.props;
const { Content } = await render(post);
const { issue, title } = parseWeeklyTitle(post);

const toLink = (item?: Post) => {
  if (!item) return undefined;
  const parsed = parseWeeklyTitle(item);
  return {
    title: parsed.issue ? `第 ${parsed.issue} 期：${parsed.title}` : parsed.title,
    href: getUrl(item),
  };
};

const meta = [issue ? `第 ${issue} 期` : '', formatLongDate(post.data.date)].filter(Boolean);
---

<Layout title={`${post.data.title} - Paranoid_K's Weekly`} description={post.data.description} active="weekly">
  <Article
    back={{ title: '周刊', href: '/weekly' }}
    title={title}
    meta={meta}
    prev={toLink(older)}
    next={toLink(newer)}
    prevLabel="上一期"
    nextLabel="下一期"
  >
    <Content />
  </Article>
</Layout>
