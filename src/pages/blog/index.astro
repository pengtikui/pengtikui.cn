---
import Layout from '../../layouts/Layout.astro';
import { getBlogPosts, getUrl, groupByYear, formatDate } from '../../utils/content';

const posts = await getBlogPosts();

const groups = groupByYear(posts, (post) => post.data.date).map(({ year, items }) => ({
  year,
  items: items.map((post) => ({
    title: post.data.title,
    description: post.data.description,
    date: formatDate(post.data.date, 'MM.dd'),
    url: getUrl(post),
  })),
}));
---

<Layout title="博客 / Blog - Paranoid_K" active="blog">
  <h1 class="text-[24px] leading-[38px] sm:text-[28px] sm:leading-[42px] font-semibold tracking-tight text-ink">博客</h1>
  <div class="mt-14">
    {
      groups.map((group) => (
        <section class="border-t border-line pt-7 pb-10 sm:grid sm:grid-cols-[96px_1fr]">
          <header>
            <h2 class="text-[22px] leading-6 font-semibold tracking-tight text-ink">{group.year}</h2>
            <p class="mt-1.5 text-xs leading-4 text-subtle">{group.items.length} 篇</p>
          </header>
          <ul class="mt-4 space-y-5 sm:mt-0">
            {group.items.map((item) => (
              <li>
                <a href={item.url} class="group block">
                  <span class="flex items-baseline justify-between gap-4">
                    <span class="min-w-0 text-[15px] leading-6 text-ink underline decoration-transparent underline-offset-4 transition-colors group-hover:decoration-[#c4c4c4]">
                      {item.title}
                    </span>
                    <span class="shrink-0 font-mono text-[13px] text-subtle">{item.date}</span>
                  </span>
                  {item.description && (
                    <span class="mt-0.5 block text-[13px] leading-5 text-[#8a8a8a]">{item.description}</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Layout>
