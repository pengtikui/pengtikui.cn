---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Article from '../../components/Article.astro';
import { type Post, getBlogPosts, getSlug, getUrl, formatLongDate } from '../../utils/content';

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  // posts 按日期倒序：后一项更早，前一项更新
  return posts.map((post, index) => ({
    params: { slug: getSlug(post) },
    props: { post, older: posts[index + 1], newer: posts[index - 1] },
  }));
}

interface Props {
  post: Post;
  older?: Post;
  newer?: Post;
}

const { post, older, newer } = Astro.props;
const { Content } = await render(post);

const toLink = (item?: Post) => (item ? { title: item.data.title, href: getUrl(item) } : undefined);
---

<Layout
  title={`${post.data.title} - Paranoid_K's Blog`}
  description={post.data.description}
  keywords={post.data.tags?.join(', ') ?? ''}
  active="blog"
>
  <Article
    back={{ title: '博客', href: '/blog' }}
    title={post.data.title}
    meta={[formatLongDate(post.data.date)]}
    tags={post.data.tags}
    prev={toLink(older)}
    next={toLink(newer)}
    prevLabel="上一篇"
    nextLabel="下一篇"
  >
    <Content />
  </Article>
</Layout>
