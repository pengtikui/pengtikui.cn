---
interface Link {
  title: string;
  href: string;
}

interface Props {
  back: Link;
  title: string;
  /** 标题下方的元信息，如「第 81 期」「2024 年 12 月 8 日」 */
  meta: string[];
  tags?: string[];
  /** 更早的一篇 */
  prev?: Link;
  /** 更新的一篇 */
  next?: Link;
  prevLabel: string;
  nextLabel: string;
}

const { back, title, meta, tags = [], prev, next, prevLabel, nextLabel } = Astro.props;
---

<article class="sm:pt-1">
  <a href={back.href} class="inline-flex items-center gap-1 text-[13px] leading-5 text-subtle transition-colors hover:text-ink">
    <span aria-hidden="true">←</span>
    {back.title}
  </a>

  <h1 class="mt-8 text-[26px] leading-[38px] sm:text-[30px] sm:leading-[42px] font-semibold tracking-tight text-ink">
    {title}
  </h1>
  <p class="mt-3.5 flex flex-wrap gap-x-4 text-[13px] leading-5 text-subtle">
    {meta.map((item) => <span>{item}</span>)}
  </p>

  <div class="article mt-11">
    <slot />
  </div>

  {
    tags.length > 0 && (
      <ul class="mt-10 flex flex-wrap gap-2.5" aria-label="标签">
        {tags.map((tag) => (
          <li class="rounded-full border border-line px-2.5 py-1 text-xs leading-4 text-[#8a8a8a]">{tag}</li>
        ))}
      </ul>
    )
  }

  {
    (prev || next) && (
      <nav class="mt-14 grid grid-cols-2 gap-6 border-t border-line pt-6" aria-label="文章导航">
        <div>
          {prev && (
            <a href={prev.href} class="group block">
              <span class="block text-xs leading-4 text-subtle">{prevLabel}</span>
              <span class="mt-2 block text-sm leading-5 text-ink underline decoration-transparent underline-offset-4 transition-colors group-hover:decoration-[#c4c4c4]">
                {prev.title}
              </span>
            </a>
          )}
        </div>
        <div class="text-right">
          {next && (
            <a href={next.href} class="group block">
              <span class="block text-xs leading-4 text-subtle">{nextLabel}</span>
              <span class="mt-2 block text-sm leading-5 text-ink underline decoration-transparent underline-offset-4 transition-colors group-hover:decoration-[#c4c4c4]">
                {next.title}
              </span>
            </a>
          )}
        </div>
      </nav>
    )
  }
</article>
