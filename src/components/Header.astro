---
type NavKey = 'weekly' | 'blog';

interface Props {
  home?: boolean;
  active?: NavKey;
}

const { home = false, active } = Astro.props;
const Brand = home ? 'h1' : 'div';

const NAV: { key: NavKey; title: string; href: string }[] = [
  { key: 'weekly', title: '周刊', href: '/weekly' },
  { key: 'blog', title: '博客', href: '/blog' },
];
---

<header class="flex items-center justify-between gap-6">
  <Brand class="min-w-0">
    <a href="/" class="flex items-center gap-3 text-ink">
      <img
        src="/avatar.jpeg"
        alt=""
        width="40"
        height="40"
        loading="eager"
        decoding="async"
        class="size-7 shrink-0 rounded-full object-cover ring-1 ring-black/5 sm:size-8"
      />
      <span class="truncate text-[24px] leading-10 font-bold tracking-tight sm:text-[30px]">Paranoid_K</span>
    </a>
  </Brand>
  <nav aria-label="主导航">
    <ul class="flex items-center gap-5 text-sm">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={item.key === active ? 'page' : undefined}
              class:list={[
                'transition-colors hover:text-ink',
                item.key === active ? 'text-ink' : 'text-[#7a7a7a]',
              ]}
            >
              {item.title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
